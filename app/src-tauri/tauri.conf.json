{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vixen",
  "mainBinaryName": "vixen-app",
  "version": "0.1.0",
  "identifier": "dev.vixen.monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vixen",
        "width": 1240,
        "height": 800,
        "minWidth": 860,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Vixen",
        "width": 600,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "minWidth": 460,
        "minHeight": 300,
        "maximizable": false,
        "minimizable": false,
        "acceptFirstMouse": true
      },
      {
        "label": "float",
        "url": "float.html",
        "title": "Vixen",
        "width": 72,
        "height": 72,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
